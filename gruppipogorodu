import json
from collections import defaultdict

# Читаем исходный файл users.json
with open('users.json', 'r', encoding='utf-8') as file:
    users = json.load(file)

cities = defaultdict(list)
for user in users:
    city = user['address']['city']
    name = user['name']
    cities[city].append(name)

cities = dict(cities)

# Сохраняем результат в cities.json
with open('cities.json', 'w', encoding='utf-8') as file:
    json.dump(cities, file, ensure_ascii=False, indent=2)

print(f"пользователи сгруппированы по {len(cities)} городам.")

